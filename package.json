{
  "name": "mobilityrelay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:ollama": "tsx watch server/ollama-dev.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:ollama": "tsx scripts/verify-ollama.ts",
    "test:ollama:ui": "tsx scripts/verify-ollama-ui.ts",
    "test:container": "tsx scripts/verify-container.ts",
    "measure:usefulness": "tsx scripts/measure-usefulness.ts",
    "mail:verify": "tsx scripts/verify-smtp.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.922.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.1.0",
    "on-headers": "1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "7.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/on-headers": "1.0.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
