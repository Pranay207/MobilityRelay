# Local-only by default. Node 24+ is required for built-in SQLite.
HOST=127.0.0.1
PORT=4317
DATA_DIR=.data

# Set these before exposing the server. Use TLS at your reverse proxy.
# APP_PASSWORD=choose-a-long-unique-password
# MCP_TOKEN=choose-an-independent-long-random-token
# PUBLIC_ORIGIN=https://your-host.example

# capture stores messages locally; it does NOT deliver them.
MAIL_MODE=capture
# MAIL_MODE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=your-verified-address@example.com

# local is a limited, deterministic command interpreter, not an LLM.
AGENT_MODE=local
# AGENT_MODE=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:1.5b
# Use a downloaded model. Loopback HTTP only; cloud-tagged names are rejected.
# AGENT_MODE=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=your-enabled-tool-capable-model-id
# AWS credentials use the SDK's standard credential chain; never commit them.
